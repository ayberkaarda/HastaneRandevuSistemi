<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console tool for the README images and the application icon. It never shows a window:
    forms are created with in-memory services and synthetic data and drawn with Control.DrawToBitmap.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HastaneRandevu.Screenshots</AssemblyName>
    <RootNamespace>HastaneRandevu.Screenshots</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HastaneRandevu.UI\HastaneRandevu.UI.csproj" />
  </ItemGroup>

</Project>
