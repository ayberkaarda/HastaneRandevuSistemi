<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HastaneRandevu.UI</RootNamespace>
    <AssemblyName>HastaneRandevu</AssemblyName>
    <Product>Hastane Randevu</Product>
    <NeutralLanguage>tr-TR</NeutralLanguage>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <UserSecretsId>hastane-randevu-ui</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="appsettings.json" Condition="Exists('appsettings.json')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Original artwork, rasterized from assets/logo.svg by tools/Screenshots (icons command). -->
    <EmbeddedResource Include="..\..\assets\logo-256.png" Link="Assets\logo-256.png" LogicalName="HastaneRandevu.UI.Assets.logo-256.png" />
    <EmbeddedResource Include="..\..\assets\app.ico" Link="Assets\app.ico" LogicalName="HastaneRandevu.UI.Assets.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HastaneRandevu.UI.Tests" />
    <InternalsVisibleTo Include="HastaneRandevu.Screenshots" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HastaneRandevu.Business\HastaneRandevu.Business.csproj" />
    <ProjectReference Include="..\HastaneRandevu.Data\HastaneRandevu.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
